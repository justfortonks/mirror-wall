<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for the notification area icon (TrayIcon.cs). -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Lets the app build (not run) on a Mac or Linux too, for checking changes. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>MirrorWall</RootNamespace>
    <AssemblyName>MirrorWall</AssemblyName>
    <ApplicationIcon>AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Mirror Wall</Product>
    <Version>0.0.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- ThemeMode (Windows 11 look, light or dark like Windows) is marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows Forms' names would clash with WPF's; TrayIcon.cs names them in full. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FFmpeg.AutoGen" Version="9.0.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MirrorCore\MirrorCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="AppIcon.ico" />
    <Resource Include="..\..\Sources\MirrorWall\Resources\AppIcon.png" Link="AppIcon.png" />
    <!-- Photos of Android phones' fronts, for their frames (PhoneBezelFrame.cs, BezelPhotos). -->
    <EmbeddedResource Include="..\..\Sources\MirrorWall\Resources\Bezels\*.png" LogicalName="Bezels.%(Filename)%(Extension)" />
    <!-- Branded theme (Themes.cs): Barlow, shared with the Mac app, under its SIL Open Font
         License, and the logo, which is kept out of git and copied only if it's been added locally. -->
    <Resource Include="..\..\Sources\MirrorWall\Resources\Brand\*.ttf" Link="Brand\%(Filename)%(Extension)" />
    <None Include="..\..\Sources\MirrorWall\Resources\Brand\OFL.txt" Link="Brand\OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Sources\MirrorWall\Resources\Brand\branded-logo*.png" Link="Brand\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
