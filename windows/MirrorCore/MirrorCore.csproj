<Project Sdk="Microsoft.NET.Sdk">

  <!-- The stream logic shared with the Mac app's MirrorCore, with no Windows code, so its tests
       run anywhere. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MirrorWall.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MirrorCore.Tests" />
  </ItemGroup>

</Project>
