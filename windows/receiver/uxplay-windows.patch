+#ifdef _WIN32
+#include <signal.h>
+
+/* Mirror Wall on Windows. A receiver that crashes exits quietly instead of putting up Windows'
+ * "uxplay.exe has stopped working" dialog in front of the wall; the app starts a fresh one. And
+ * with MIRROR_WALL_QUIT_ON_EOF=1, the app can stop uxplay cleanly by closing its input: a program
+ * without a console of its own can't be sent Ctrl-C. */
+static void mirror_wall_crashed(const char *what) {
+    char message[600];
+    int length = snprintf(message, sizeof(message), "*** Mirror Wall: uxplay crashed (%s); exiting without a crash report\n", what);
+    DWORD written;
+    WriteFile(GetStdHandle(STD_ERROR_HANDLE), message, length, &written, NULL);
+    TerminateProcess(GetCurrentProcess(), 3);
+}
+
+static void mirror_wall_abort(int sig) {
+    mirror_wall_crashed("abort");
+}
+
+/* Names the exception and the library it happened in, for the slot's log. */
+static LONG WINAPI mirror_wall_exception(EXCEPTION_POINTERS *info) {
+    char what[520];
+    char module[MAX_PATH] = "unknown library";
+    void *address = info->ExceptionRecord->ExceptionAddress;
+    HMODULE handle = NULL;
+    if (GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                           (LPCSTR) address, &handle)) {
+        GetModuleFileNameA(handle, module, sizeof(module));
+    }
+    snprintf(what, sizeof(what), "exception 0x%08lx at %s+0x%llx", info->ExceptionRecord->ExceptionCode, module,
+             (unsigned long long) ((char *) address - (char *) handle));
+    mirror_wall_crashed(what);
+    return EXCEPTION_EXECUTE_HANDLER;
+}
+
+static DWORD WINAPI mirror_wall_watch_input(LPVOID arg) {
+    char buffer[256];
+    DWORD count;
+    while (ReadFile(GetStdHandle(STD_INPUT_HANDLE), buffer, sizeof(buffer), &count, NULL) && count > 0) {}
+    LOGI("*** Mirror Wall: input closed, shutting down");
+    /* Quit the way Ctrl-C does, from the main loop, once it's running (it isn't yet while uxplay
+     * starts, and briefly not while it restarts after a disconnect). */
+    while (!gmainloop) {
+        Sleep(100);
+    }
+    g_idle_add(handle_signal, NULL);
+    return 0;
+}
+
+/* uxplay checks its arguments are UTF-8 and quietly exits if not, but Windows hands main() them
+ * in the PC's legacy code page, so a slot name like "Mirror Wall 1 · PC" stopped it at once. Take
+ * them from the Unicode command line instead. */
+#include <shellapi.h>
+static void mirror_wall_utf8_arguments(int *argc, char ***argv) {
+    int count = 0;
+    LPWSTR *wide = CommandLineToArgvW(GetCommandLineW(), &count);
+    if (!wide) {
+        return;
+    }
+    char **utf8 = (char **) calloc(count + 1, sizeof(char *));
+    for (int i = 0; i < count; i++) {
+        int size = WideCharToMultiByte(CP_UTF8, 0, wide[i], -1, NULL, 0, NULL, NULL);
+        utf8[i] = (char *) malloc(size > 0 ? size : 1);
+        utf8[i][0] = '\0';
+        if (size > 0) {
+            WideCharToMultiByte(CP_UTF8, 0, wide[i], -1, utf8[i], size, NULL, NULL);
+        }
+    }
+    LocalFree(wide);
+    *argc = count;
+    *argv = utf8;
+}
+
+static void mirror_wall_install_windows() {
+    SetErrorMode(SEM_FAILCRITICALERRORS | SEM_NOGPFAULTERRORBOX | SEM_NOOPENFILEERRORBOX);
+    _set_abort_behavior(0, _WRITE_ABORT_MSG | _CALL_REPORTFAULT);
+    signal(SIGABRT, mirror_wall_abort);
+    SetUnhandledExceptionFilter(mirror_wall_exception);
+    const char *quit_on_eof = getenv("MIRROR_WALL_QUIT_ON_EOF");
+    if (quit_on_eof && quit_on_eof[0] == '1') {
+        CreateThread(NULL, 0, mirror_wall_watch_input, NULL, 0, NULL);
+    }
+}
+#endif
+
