+#ifdef __APPLE__
+/* Mirror Wall: a receiver that crashes (an assertion in GStreamer or uxplay, typically as a phone
+ * disconnects) exits quietly instead, so macOS doesn't put up its "quit unexpectedly" dialog in
+ * front of the wall. The app sees the exit and starts a fresh receiver. */
+static void mirror_wall_quiet_crash(int sig) {
+    const char message[] = "*** Mirror Wall: uxplay crashed; exiting without a crash report\n";
+    write(STDERR_FILENO, message, sizeof(message) - 1);
+    _exit(128 + sig);
+}
+
+static void mirror_wall_install_quiet_crash() {
+    const int signals[] = { SIGABRT, SIGSEGV, SIGBUS, SIGILL, SIGFPE, SIGTRAP };
+    for (int sig : signals) {
+        signal(sig, mirror_wall_quiet_crash);
+    }
+}
+#endif
+
